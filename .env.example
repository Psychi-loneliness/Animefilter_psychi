# ── required ────────────────────────────────────────────────────────────────
# Get this from @BotFather → /newbot
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma separated Telegram numeric user ids that can run /add, /setgroup, ...
ADMIN_IDS=111111111,222222222

# ── optional ────────────────────────────────────────────────────────────────
DB_PATH=animebot.db
BRAND=Anime Galaxy
# Send the "tap the menu" nudge when people chat in the group
AUTO_MENU=true
# Minimum seconds between two nudges in the same chat
AUTO_MENU_COOLDOWN=180
# How long a search waits for the typed name
SEARCH_TIMEOUT=180
# Titles per page in result lists
PAGE_SIZE=8
LOG_LEVEL=INFO
